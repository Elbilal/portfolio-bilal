{
  "name": "elbadaouy-bilal-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio site — content-driven via locales/*.json (en, fr, ar), built with Tailwind CSS.",
  "private": true,
  "scripts": {
    "dev": "npx serve . -l 5173",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch",
    "build": "npm run build:css",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.2",
    "playwright": "^1.64.0",
    "postcss": "^8.5.25",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.19"
  }
}
